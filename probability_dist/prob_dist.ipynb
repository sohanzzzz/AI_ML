    "from fractions import Fraction\n",
    "from scipy.stats import binom\n",
    "p = 0.5\n",
    "n = 5\n",
    "k = 3\n",
    "prob = binom.pmf(k, n, p)\n",
    "Fraction(prob).limit_denominator()"
